# Public label shown in the UI
NEXT_PUBLIC_EVENT_NAME="QR Scavenger Hunt"

# Used to generate QR URLs in the admin dashboard. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase project settings. Use the service-role key, not the anon key.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Admin dashboard password
SCAVENGER_ADMIN_PASSWORD="change-this-password"
